[Unit]
Description=VIGIA 2.0 — continuous UV monitor (dual OV5647 raw + spectrometer)
After=network.target chrony.service

[Service]
User=user
Type=simple
WorkingDirectory=/home/user
# Stream print() logs to journald live; without this Python block-buffers stdout.
Environment=PYTHONUNBUFFERED=1
Environment=LIBCAMERA_LOG_LEVELS=*:ERROR
# Owns both UV cameras and the spectrometer while running and captures on round
# UTC multiples of [uv_sync] monitor_interval_s. vigia-orchestrator.service
# checks it and starts it if it is down. Add --no-spectrometer to ExecStart when
# the spectrometer is not connected.
# Wait (up to ~30 s) for chrony to sync so file names/timestamps are right;
# the leading "-" starts anyway if it never syncs (uvcam is the time source;
# without a GPS fix the Witty Pi RTC still gives a close time). Kept under the
# orchestrator's 60 s timeout on "systemctl start" (it blocks through
# ExecStartPre). Re-runs on every automatic restart.
ExecStartPre=-/usr/bin/chronyc waitsync 3 0.5
ExecStart=/home/user/.venv/bin/multicamctl capture uv-sync --monitor
Restart=always
RestartSec=10
# SIGTERM ends the loop after the current capture and closes the devices.
KillSignal=SIGTERM
TimeoutStartSec=60
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
