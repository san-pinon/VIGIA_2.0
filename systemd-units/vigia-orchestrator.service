[Unit]
Description=VIGIA 2.0 — orchestrator (Canon + environmental schedule, supervises the UV/IR monitors)
After=network-online.target chrony.service
Wants=network-online.target

[Service]
User=user
Type=simple
WorkingDirectory=/home/user
Environment=PYTHONUNBUFFERED=1
# Wait (up to ~1 min) for chrony to sync, so the first captures carry a good
# time; the leading "-" starts the orchestrator anyway if it never syncs. uvcam
# is the time source itself: without a GPS fix (indoors, cold start) waiting
# longer doesn't help, and the Witty Pi RTC (coin cell) already gives a close
# time. Also re-runs on every automatic restart, so keep it short.
ExecStartPre=-/usr/bin/chronyc waitsync 6 0.5
# Runs on uvcam. Schedules [orchestrator] schedule on the UTC clock and checks
# the [orchestrator] supervise units (capture-uv-monitor here,
# capture-ir-video on multicam), starting them if they are down.
ExecStart=/home/user/.venv/bin/vigia-orchestrator
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStartSec=120
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
