[Unit]
Description=VIGIA 2.0 — file monitor and archival daemon
After=network.target

[Service]
User=user
Type=simple
WorkingDirectory=/home/user
# Stream print() logs to journald live; without this Python block-buffers stdout.
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/user/.venv/bin/python /home/user/multicam/scripts/file_monitor.py
Restart=always
RestartSec=10s

[Install]
WantedBy=multi-user.target
